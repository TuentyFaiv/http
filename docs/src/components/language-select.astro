---
import DefaultLanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
---

<div class="fz-language-select">
	<DefaultLanguageSelect />
</div>

<style>
	.fz-language-select {
		display: contents;
	}

	/* Keep Starlight's locale URLs, translated label, and bfcache restoration on mobile too. */
	@media (max-width: 49.999rem) {
		:global(header.header) .fz-language-select :global(select) {
			width: 2.75rem;
			min-width: 2.75rem;
			padding-inline: 0;
			margin-inline: 0;
			color: transparent;
		}

		:global(header.header) .fz-language-select :global(option) {
			color: var(--fz-ink);
			background: var(--fz-page);
		}

		:global(header.header) .fz-language-select :global(.label-icon) {
			inset-inline-start: 0.75rem;
		}

		:global(header.header) .fz-language-select :global(.caret) {
			display: none;
		}
	}
</style>
