{
	"name": "fetchzen",
	"version": "0.2.0",
	"description": "TypeScript-first HTTP client built on native Fetch, with typed responses, validation, retries, and zero runtime dependencies.",
	"keywords": [
		"Http",
		"Library",
		"TypeScript"
	],
	"homepage": "https://fetchzen.dev/",
	"bugs": {
		"url": "https://github.com/TuentyFaiv/http/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TuentyFaiv/http.git"
	},
	"license": "MIT",
	"author": "Tonalli López <contact@tuentyfaiv.com>",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./helpers": {
			"types": "./dist/helpers.d.ts",
			"import": "./dist/helpers.js",
			"default": "./dist/helpers.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"workspaces": [
		"docs"
	],
	"scripts": {
		"build": "tsdown",
		"check": "biome check",
		"check:fix": "biome check --write",
		"clean": "rimraf ./dist",
		"dev": "bun run --filter fetchzen-docs dev",
		"dev:library": "tsdown --watch",
		"docs": "bun run dev",
		"docs:build": "bun run --filter fetchzen-docs build",
		"docs:preview": "bun run --filter fetchzen-docs preview",
		"format": "biome format --write",
		"format:check": "biome format",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"pack:check": "bun run build && bun pm pack --dry-run",
		"package:smoke": "bun run build && bun scripts/package-smoke.mjs",
		"prepublishOnly": "bun run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"rimraf": "^6.0.1",
		"tsdown": "^0.23.0",
		"typescript": "^5.2.2",
		"vitest": "^3.0.0"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	}
}
